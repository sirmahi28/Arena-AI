{
  "name": "sugar-rush",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sugar Rush — a juicy mobile-first match-3 game built with Canvas 2D",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tools/board-sim.mjs 1500",
    "test:calibrate": "node tools/board-sim.mjs 300 --calibrate",
    "shots": "node tools/shots.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
